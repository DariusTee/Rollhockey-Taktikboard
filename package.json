{
  "name": "rollhockey-taktikboard",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:static && npm run test:rules && npm run test:functions && npm --prefix functions test",
    "test:static": "node --test tests/static-html.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rollhockey-taktikboard \"node --test tests/firestore.rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-rollhockey-taktikboard \"node --test tests/functions.integration.test.mjs\"",
    "serve": "firebase emulators:start --only auth,firestore,functions,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "parse5": "8.0.0"
  }
}
